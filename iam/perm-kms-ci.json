{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CiDecryptViaS3Only",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:eu-west-3:ACCOUNT:key/KEY-ID",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.eu-west-3.amazonaws.com"
        }
      }
    }
  ]
}

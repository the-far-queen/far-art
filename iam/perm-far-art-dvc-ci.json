{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPrefixFarArtOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::far-art-assets",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "far-art",
            "far-art/*"
          ]
        }
      }
    },
    {
      "Sid": "GetObjectsFarArtPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectTagging"
      ],
      "Resource": "arn:aws:s3:::far-art-assets/far-art/*"
    }
  ]
}

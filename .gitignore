# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# far-art policy: image assets are allowed (this is an art repo),
# but each image MUST have a sibling sheet.json or sheet.yaml.
# A naked image (no sheet) is refused by the gate.
#
# We do NOT enforce that at git level (CI will), but we do keep
# the root + tools/ + tests/ image-free as a hygiene rule.
# Sheets/boards/examples MAY contain image files alongside their sheets.

# DVC (Data Version Control)
# DVC files (.dvc, .dvctable) are tracked by git; the data they
# reference is NOT.
.dvc/cache
.dvc/tmp
.dvc/lock
.dvc/state
.dvc/state.tmp
.dvc/state.lock
.dvc/updater
.dvc/ignore
dvc.lock
dvc.yaml.lock
